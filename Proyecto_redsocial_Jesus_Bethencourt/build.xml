<?xml version="1.0" encoding="UTF-8"?>
<project name="ProyectoRedSocial" default="jar" basedir=".">
    <description>Proyecto de Análisis de Red Social</description>
    
    <!-- Propiedades del proyecto -->
    <property name="src.dir" location="src"/>
    <property name="build.dir" location="build"/>
    <property name="dist.dir" location="dist"/>
    <property name="lib.dir" location="lib"/>
    <property name="test.dir" location="test"/>
    <property name="datos.dir" location="datos"/>
    
    <!-- Inicialización -->
    <target name="init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${dist.dir}"/>
        <mkdir dir="${datos.dir}"/>
    </target>
    
    <!-- Compilación -->
    <target name="compile" depends="init" description="Compilar el código fuente">
        <javac srcdir="${src.dir}" destdir="${build.dir}" includeantruntime="false">
            <classpath>
                <fileset dir="${lib.dir}" includes="**/*.jar"/>
            </classpath>
        </javac>
    </target>
    
    <!-- Crear JAR -->
    <target name="jar" depends="compile" description="Crear archivo JAR">
        <jar destfile="${dist.dir}/ProyectoRedSocial.jar" basedir="${build.dir}">
            <manifest>
                <attribute name="Main-Class" value="redsocial.Main"/>
                <attribute name="Class-Path" value="lib/gs-core-2.0.jar lib/gs-ui-swing-2.0.jar"/>
            </manifest>
        </jar>
        <copy todir="${dist.dir}/lib">
            <fileset dir="${lib.dir}"/>
        </copy>
    </target>
    
    <!-- Ejecutar aplicación -->
    <target name="run" depends="jar" description="Ejecutar la aplicación">
        <java jar="${dist.dir}/ProyectoRedSocial.jar" fork="true">
            <classpath>
                <pathelement path="${dist.dir}/ProyectoRedSocial.jar"/>
                <fileset dir="${lib.dir}" includes="**/*.jar"/>
            </classpath>
        </java>
    </target>
    
    <!-- Limpiar archivos generados -->
    <target name="clean" description="Limpiar archivos generados">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
    
    <!-- Compilar y ejecutar tests -->
    <target name="test" depends="compile" description="Ejecutar tests">
        <javac srcdir="${test.dir}" destdir="${build.dir}" includeantruntime="false">
            <classpath>
                <pathelement path="${build.dir}"/>
                <fileset dir="${lib.dir}" includes="**/*.jar"/>
            </classpath>
        </javac>
        <junit printsummary="yes" haltonfailure="yes">
            <classpath>
                <pathelement path="${build.dir}"/>
                <fileset dir="${lib.dir}" includes="**/*.jar"/>
            </classpath>
            <formatter type="plain"/>
            <batchtest fork="yes">
                <fileset dir="${test.dir}" includes="**/*Test.java"/>
            </batchtest>
        </junit>
    </target>
</project>
